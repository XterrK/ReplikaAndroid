# REPLIKA — пример переменных окружения для сборки.
#
# Приложению во время работы переменные окружения не нужны: всё работает офлайн
# на телефоне, ключей API и адресов серверов нет.
# Этот файл описывает только сборку из исходников и стенд оценки.
# Подробно: src/README.md и PORTABILITY.md.
#
# Скопируйте в .env или задайте переменные в своей оболочке.
# Пути ниже — примеры, замените их на свои.

# --- Обязательно для сборки ---

# Корень JDK 17. Если не задан, build_portable.py ищет javac в PATH.
JAVA_HOME=/opt/jdk-17

# Корень Android SDK с platform 35, build-tools 35.0.0 и NDK 27.2.12479018.
# Можно вместо этого указать sdk.dir в local.properties (не оба с разными путями).
ANDROID_HOME=/opt/android-sdk

# --- Необязательно ---

# Синоним ANDROID_HOME. Если заданы оба, они должны совпадать.
# ANDROID_SDK_ROOT=/opt/android-sdk

# Где Gradle держит кэш. По умолчанию: local-dev/gradle внутри проекта.
# GRADLE_USER_HOME=local-dev/gradle

# Где лежит отладочный ключ debug.keystore, если его нет в local-dev/.
# По умолчанию: local-dev/.
# ANDROID_USER_HOME=local-dev

# --- Профили конвейера (свойства Gradle, передаются как -P<имя>=<значение>) ---
# Значения по умолчанию — текущий измеренный конвейер.
# Чтобы собрать прежнюю версию V1.6, задайте всем трём значение v16.

# Распознавание: vad_words_context600 (по умолчанию) | v16
REPLIKA_ASR_PLAN=vad_words_context600

# Говорящие: eres2net_window_v1 (по умолчанию, требует vad_words_context600) | v16
REPLIKA_DIAR_PLAN=eres2net_window_v1

# Потоки CPU: auto_v1 (по умолчанию) | v16
REPLIKA_CPU_PLAN=auto_v1

# Пример команды с этими значениями:
#   python3 tools/build_portable.py :app:assembleAllInOne \
#     -PreplikaAsrPlan=$REPLIKA_ASR_PLAN \
#     -PreplikaDiarPlan=$REPLIKA_DIAR_PLAN \
#     -PreplikaCpuPlan=$REPLIKA_CPU_PLAN
#
# Gradle не читает переменные REPLIKA_*_PLAN сам: это только удобные имена
# для подстановки в команду.

# --- Стенд оценки качества (tools/eval, только на ПК) ---

# Папка для скачанного и сгенерированного тестового аудио (вне Git).
# REPLIKA_EVAL_AUDIO=local-dev/eval-audio
