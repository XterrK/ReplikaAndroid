      "wordEvidenceOmittedReason": "not_requested"
    },
    {
      "startMs": 46126,
      "endMs": 52742,
      "speakerId": -1,
      "text": "The current press presents continuously new stages of its progress, new developments of its plan.",
      "blank": false,
      "inferenceMs": 6686,
      "tokenCount": 34,
      "timestampCount": 34,
      "wordCount": 15,
