    },
    {
      "startMs": 40974,
      "endMs": 45926,
      "speakerId": -1,
      "text": "And so the story of Mormonism runs on. Its finale has not yet been written.",
      "blank": false,
      "inferenceMs": 3904,
      "tokenCount": 28,
      "timestampCount": 28,
      "wordCount": 15,
