    {
      "startMs": 17454,
      "endMs": 25286,
      "speakerId": -1,
      "text": "cried one of the women. He took no notice of her. He looked at me, but as if, instead of me, he saw what he spoke of.",
      "blank": false,
      "inferenceMs": 7390,
      "tokenCount": 45,
      "timestampCount": 45,
