    },
    {
      "startMs": 53614,
      "endMs": 58630,
      "speakerId": -1,
      "text": "I didn't have any fears, if I worked it rightly, said the old gentleman complacently.",
      "blank": false,
      "inferenceMs": 5011,
      "tokenCount": 33,
      "timestampCount": 33,
      "wordCount": 15,
