    },
    {
      "startMs": 35374,
      "endMs": 40390,
      "speakerId": -1,
      "text": "To give full growth to that which still doth grow.",
      "blank": false,
      "inferenceMs": 5390,
      "tokenCount": 16,
      "timestampCount": 16,
      "wordCount": 10,
      "frameStrideMs": 80,
      "wordAssignmentSupported": true,
