    {
      "startMs": 29742,
      "endMs": 31718,
      "speakerId": -1,
      "text": "Love is a babe.",
      "blank": false,
      "inferenceMs": 2663,
      "tokenCount": 9,
      "timestampCount": 9,
      "wordCount": 4,
      "frameStrideMs": 80,
      "wordAssignmentSupported": true,
      "wordAssignmentReason": "supported",
      "timestampUnit": "seconds within ASR VAD chunk",
