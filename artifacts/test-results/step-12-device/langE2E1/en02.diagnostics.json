    },
    {
      "startMs": 25422,
      "endMs": 28614,
      "speakerId": -1,
      "text": "If she could only see Phronsie for just one moment.",
      "blank": false,
      "inferenceMs": 4111,
      "tokenCount": 17,
      "timestampCount": 17,
      "wordCount": 10,
      "frameStrideMs": 80,
      "wordAssignmentSupported": true,
