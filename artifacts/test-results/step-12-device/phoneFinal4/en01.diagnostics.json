  "asrSlices": [
    {
      "startMs": 142,
      "endMs": 3750,
      "speakerId": -1,
      "text": "Since when has malady banished medicine?",
      "blank": false,
      "inferenceMs": 479,
      "tokenCount": 17,
      "timestampCount": 17,
      "wordCount": 6,
      "frameStrideMs": 80,
      "wordAssignmentSupported": true,
      "wordAssignmentReason": "supported",
      "timestampUnit": "seconds within ASR VAD chunk",
      "warnings": [],
      "wordEvidenceIncluded": false,
      "wordEvidenceOmittedReason": "not_requested"
    },
    {
      "startMs": 4686,
      "endMs": 14150,
      "speakerId": -1,
      "text": "Therefore, I feel myself quite able, as President of this Republic, to receive you with a courtesy due to the servants of a friendly ally.",
      "blank": false,
      "inferenceMs": 998,
      "tokenCount": 51,
      "timestampCount": 51,
      "wordCount": 25,
      "frameStrideMs": 80,
      "wordAssignmentSupported": true,
      "wordAssignmentReason": "supported",
      "timestampUnit": "seconds within ASR VAD chunk",
      "warnings": [],
      "wordEvidenceIncluded": false,
      "wordEvidenceOmittedReason": "not_requested"
    },
    {
      "startMs": 14734,
      "endMs": 26278,
      "speakerId": -1,
      "text": "When it is a question of probing a wound, a gulf, a society, since when has it been considered wrong to go too far, to go to the bottom?",
      "blank": false,
      "inferenceMs": 1231,
      "tokenCount": 51,
      "timestampCount": 51,
      "wordCount": 29,
      "frameStrideMs": 80,
      "wordAssignmentSupported": true,
      "wordAssignmentReason": "supported",
      "timestampUnit": "seconds within ASR VAD chunk",
      "warnings": [],
      "wordEvidenceIncluded": false,
      "wordEvidenceOmittedReason": "not_requested"
    },
    {
      "startMs": 26766,
      "endMs": 29222,
      "speakerId": -1,
      "text": "Today? I shouted.",
      "blank": false,
      "inferenceMs": 337,
      "tokenCount": 9,
      "timestampCount": 9,
      "wordCount": 3,
      "frameStrideMs": 80,
      "wordAssignmentSupported": true,
      "wordAssignmentReason": "supported",
      "timestampUnit": "seconds within ASR VAD chunk",
      "warnings": [],
      "wordEvidenceIncluded": false,
      "wordEvidenceOmittedReason": "not_requested"
    },
    {
      "startMs": 29998,
      "endMs": 33990,
      "speakerId": -1,
      "text": "We have never understood this sort of objections.",
      "blank": false,
      "inferenceMs": 481,
      "tokenCount": 13,
      "timestampCount": 13,
      "wordCount": 8,
      "frameStrideMs": 80,
      "wordAssignmentSupported": true,
      "wordAssignmentReason": "supported",
      "timestampUnit": "seconds within ASR VAD chunk",
      "warnings": [],
      "wordEvidenceIncluded": false,
      "wordEvidenceOmittedReason": "not_requested"
    },
    {
      "startMs": 34926,
      "endMs": 36422,
      "speakerId": -1,
      "text": "As I spoke,",
      "blank": false,
      "inferenceMs": 278,
      "tokenCount": 6,
      "timestampCount": 6,
      "wordCount": 3,
      "frameStrideMs": 80,
      "wordAssignmentSupported": true,
      "wordAssignmentReason": "supported",
      "timestampUnit": "seconds within ASR VAD chunk",
      "warnings": [],
      "wordEvidenceIncluded": false,
      "wordEvidenceOmittedReason": "not_requested"
    },
    {
      "startMs": 36430,
      "endMs": 45542,
      "speakerId": -1,
      "text": "I made him a gracious bow, and I think I showed him by my mode of address that I did not bear any grudge as to my individual self.",
      "blank": false,
      "inferenceMs": 952,
      "tokenCount": 46,
      "timestampCount": 46,
      "wordCount": 29,
      "frameStrideMs": 80,
      "wordAssignmentSupported": true,
      "wordAssignmentReason": "supported",
      "timestampUnit": "seconds within ASR VAD chunk",
      "warnings": [],
      "wordEvidenceIncluded": false,
      "wordEvidenceOmittedReason": "not_requested"
    },
    {
      "startMs": 46158,
      "endMs": 54438,
      "speakerId": -1,
      "text": "To diminish the number of the shady, to augment the number of the luminous, that is the object,",
      "blank": false,
      "inferenceMs": 892,
      "tokenCount": 31,
      "timestampCount": 31,
      "wordCount": 18,
      "frameStrideMs": 80,
      "wordAssignmentSupported": true,
      "wordAssignmentReason": "supported",
      "timestampUnit": "seconds within ASR VAD chunk",
      "warnings": [],
      "wordEvidenceIncluded": false,
      "wordEvidenceOmittedReason": "not_requested"
    },
    {
      "startMs": 54702,
      "endMs": 62182,
      "speakerId": -1,
      "text": "Jack had been standing in the far corner of the room talking to Eva, and was now reduced to silence by his praises.",
      "blank": false,
      "inferenceMs": 775,
      "tokenCount": 44,
      "timestampCount": 44,
      "wordCount": 23,
      "frameStrideMs": 80,
      "wordAssignmentSupported": true,
      "wordAssignmentReason": "supported",
      "timestampUnit": "seconds within ASR VAD chunk",
      "warnings": [],
      "wordEvidenceIncluded": false,
