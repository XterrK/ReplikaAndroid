    {
      "speaker_id": "speaker_3",
      "start_ms": 19650,
      "end_ms": 20872,
      "text": "И общее здоровье."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 21057,
      "end_ms": 22964,
      "text": "Спасибо, Дима. Это очень мило с твоей"
