{
  "transcript": [
    {
      "speaker_id": "speaker_1",
      "start_ms": 664,
      "end_ms": 1824,
      "text": "Это ужасные новости."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 2352,
      "end_ms": 5392,
      "text": "Такие люди оставляют неизгладимый след в наших жизнях."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 6528,
      "end_ms": 9488,
      "text": "Ногинск, улица Советская, дом 9."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 10568,
      "end_ms": 11608,
      "text": "Да уж, бесит это."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 12160,
      "end_ms": 14120,
      "text": "А у меня тоже соседи шумят по ночам."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 14696,
      "end_ms": 14976,
      "text": "Маша."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 15880,
      "end_ms": 18200,
      "text": "Ты слышала, что произошло на встрече с партнёрами?"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 19024,
      "end_ms": 19264,
      "text": "Этот"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 19824,
      "end_ms": 20104,
      "text": "Новый"
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 20184,
      "end_ms": 22064,
      "text": "менеджер сделал такой жуткий выход."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 22816,
      "end_ms": 24696,
      "text": "Что я просто остался в шоке."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 25600,
      "end_ms": 25800,
      "text": "Что ж"
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 26088,
      "end_ms": 29248,
      "text": "Давай продолжать исследовать вкусовые грани французской кухни."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 30584,
      "end_ms": 30624,
      "text": "Да."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 31520,
      "end_ms": 32600,
      "text": "Жаль, что она уже не с"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 32680,
      "end_ms": 32840,
      "text": "нами."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 33440,
      "end_ms": 34880,
      "text": "Но воспоминания остались."
    }
  ]
}
