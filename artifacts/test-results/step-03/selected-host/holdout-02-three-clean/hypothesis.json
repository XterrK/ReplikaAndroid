{
  "transcript": [
    {
      "speaker_id": "speaker_1",
      "start_ms": 736,
      "end_ms": 3176,
      "text": "Это замечательное место для детей и взрослых."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 3696,
      "end_ms": 7456,
      "text": "Ещё можно сходить в концкамеру на Университетской набережной, дом 3."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 7848,
      "end_ms": 8168,
      "text": "Метро?"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 8344,
      "end_ms": 9224,
      "text": "Адмиралтейская."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 10312,
      "end_ms": 14592,
      "text": "А ещё я обожаю петербургские кафе с их ароматным кофе и десертами."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 15232,
      "end_ms": 17912,
      "text": "Как приятно провести время, наслаждаясь вкусной выпечкой."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 19440,
      "end_ms": 22640,
      "text": "Важно не паниковать и не принимать поспешных решений."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 23216,
      "end_ms": 25976,
      "text": "Лучше заранее иметь план действий на случай политических"
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 26176,
      "end_ms": 26416,
      "text": "рынков."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 26880,
      "end_ms": 28760,
      "text": "И диверсифицировать портфель."
    },
    {
      "speaker_id": "speaker_5",
      "start_ms": 29304,
      "end_ms": 29704,
      "text": "Ты права."
    },
    {
      "speaker_id": "speaker_5",
      "start_ms": 29992,
      "end_ms": 31272,
      "text": "Часто самые важные вещи"
    },
    {
      "speaker_id": "speaker_5",
      "start_ms": 31784,
      "end_ms": 34144,
      "text": "Происходят за пределами нашей зоны комфорта."
    },
    {
      "speaker_id": "speaker_6",
      "start_ms": 35160,
      "end_ms": 38920,
      "text": "Ну, мне кажется, что в каждой легенде есть зерно правды."
    },
    {
      "speaker_id": "speaker_7",
      "start_ms": 39376,
      "end_ms": 42616,
      "text": "Говорят, что в том доме жил какой-то странный старик."
    },
    {
      "speaker_id": "speaker_7",
      "start_ms": 43128,
      "end_ms": 43168,
      "text": "который"
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 44968,
      "end_ms": 46368,
      "text": "А я обожаю крепость."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 46928,
      "end_ms": 50128,
      "text": "Особенно с разными начинками: от сладких до сырных."
    },
    {
      "speaker_id": "speaker_8",
      "start_ms": 51408,
      "end_ms": 51928,
      "text": "Положительно."
    },
    {
      "speaker_id": "speaker_8",
      "start_ms": 52448,
      "end_ms": 55648,
      "text": "Считаю, что изменения помогают развиваться и улучшать процессы."
    },
    {
      "speaker_id": "speaker_9",
      "start_ms": 56152,
      "end_ms": 56192,
      "text": "А"
    },
    {
      "speaker_id": "speaker_9",
      "start_ms": 56312,
      "end_ms": 56352,
      "text": "ты?"
    },
    {
      "speaker_id": "speaker_10",
      "start_ms": 57288,
      "end_ms": 57928,
      "text": "Да, Маша."
    },
    {
      "speaker_id": "speaker_10",
      "start_ms": 58736,
      "end_ms": 59336,
      "text": "Это удивительно."
    },
    {
      "speaker_id": "speaker_11",
      "start_ms": 60168,
      "end_ms": 61648,
      "text": "И каждый год мы видим"
    },
    {
      "speaker_id": "speaker_11",
      "start_ms": 62144,
      "end_ms": 62904,
      "text": "Новые лица."
    },
    {
      "speaker_id": "speaker_11",
      "start_ms": 63584,
      "end_ms": 64584,
      "text": "Новые таланты."
    },
    {
      "speaker_id": "speaker_11",
      "start_ms": 65144,
      "end_ms": 66664,
      "text": "Это действительно вдохновляет."
    },
    {
      "speaker_id": "speaker_12",
      "start_ms": 67984,
      "end_ms": 70904,
      "text": "Согласна, скелетон — это просто адреналин на максимуме."
    },
    {
      "speaker_id": "speaker_12",
      "start_ms": 71456,
      "end_ms": 73776,
      "text": "А ты когда-нибудь пробовал что-то из этих видов спорта?"
    }
  ]
}
