{
  "transcript": [
    {
      "speaker_id": "speaker_1",
      "start_ms": 646,
      "end_ms": 1806,
      "text": "Это ужасные новости."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 2334,
      "end_ms": 5414,
      "text": "Такие люди оставляют неизгладимый след в наших жизнях."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 6550,
      "end_ms": 9510,
      "text": "Ногинск, улица Советская, дом 9."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 10590,
      "end_ms": 11630,
      "text": "Да уж, бесит это."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 12142,
      "end_ms": 14102,
      "text": "А у меня тоже соседи шумят по ночам."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 14678,
      "end_ms": 14958,
      "text": "Маша"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 15862,
      "end_ms": 18222,
      "text": "Ты слышала, что произошло на встрече с партнёрами?"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 19046,
      "end_ms": 19246,
      "text": "Этот"
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 19846,
      "end_ms": 22086,
      "text": "Новый менеджер сделал такой жуткий выход."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 22798,
      "end_ms": 24718,
      "text": "Что я просто остался в шоке."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 25662,
      "end_ms": 29262,
      "text": "Что ж, давай продолжать исследовать вкусовые грани французской кухни."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 30566,
      "end_ms": 30606,
      "text": "Да."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 31502,
      "end_ms": 32582,
      "text": "Жаль, что она уже не с"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 32662,
      "end_ms": 32822,
      "text": "нами."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 33462,
      "end_ms": 34862,
      "text": "Но воспоминания остались."
    }
  ]
