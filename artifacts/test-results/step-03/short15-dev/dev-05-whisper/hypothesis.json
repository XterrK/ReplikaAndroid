{
  "transcript": [
    {
      "speaker_id": "speaker_1",
      "start_ms": 662,
      "end_ms": 1662,
      "text": "В каком смысле?"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 3294,
      "end_ms": 3654,
      "text": "Маша."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 4510,
      "end_ms": 8350,
      "text": "Знаешь, я всегда ценил нашу способность быть откровенными."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 9102,
      "end_ms": 9782,
      "text": "Друг с другом."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 10326,
      "end_ms": 12086,
      "text": "Даже когда мы не соглашались."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 13750,
      "end_ms": 14150,
      "text": "Уделяю"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 14270,
      "end_ms": 14870,
      "text": "время своим"
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 14950,
      "end_ms": 15310,
      "text": "хобби"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 15590,
      "end_ms": 16230,
      "text": "и отдыху."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 16670,
      "end_ms": 17990,
      "text": "Это было бы неплохо."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 19350,
      "end_ms": 20350,
      "text": "Попробуем заново."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 21494,
      "end_ms": 22854,
      "text": "Приятного чаепития."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 23694,
      "end_ms": 26494,
      "text": "Если что-то понадобится, звони мне."
    },
    {
      "speaker_id": "speaker_5",
      "start_ms": 27582,
      "end_ms": 31662,
      "text": "Иваново, улица Ленина, дом 45."
    }
  ]
}
