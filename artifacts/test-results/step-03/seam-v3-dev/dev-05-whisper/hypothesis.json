{
  "transcript": [
    {
      "speaker_id": "speaker_1",
      "start_ms": 658,
      "end_ms": 1658,
      "text": "В каком смысле?"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 3290,
      "end_ms": 3650,
      "text": "Маша."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 4546,
      "end_ms": 8346,
      "text": "Знаешь, я всегда ценил нашу способность быть откровенными."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 9098,
      "end_ms": 9778,
      "text": "Друг с другом."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 10322,
      "end_ms": 12082,
      "text": "Даже когда мы не соглашались."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 13746,
      "end_ms": 14146,
      "text": "Уделяю."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 14266,
      "end_ms": 14866,
      "text": "Время своим."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 14946,
      "end_ms": 15306,
      "text": "Хобби."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 15586,
      "end_ms": 16226,
      "text": "И отдыху."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 16666,
      "end_ms": 17986,
      "text": "Это было бы неплохо."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 19346,
      "end_ms": 20346,
      "text": "Попробуем заново."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 21490,
      "end_ms": 22850,
      "text": "Приятного чаепития."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 23690,
      "end_ms": 26490,
      "text": "Если что-то понадобится, звони мне."
    },
    {
      "speaker_id": "speaker_5",
      "start_ms": 27578,
      "end_ms": 31658,
      "text": "Иваново, улица Ленина, дом 45."
    }
  ]
