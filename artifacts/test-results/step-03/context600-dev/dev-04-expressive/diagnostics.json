      "warnings": []
    },
    {
      "startMs": 14726,
      "endMs": 14966,
      "speakerId": 0,
      "text": "Маша",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    },
    {
      "startMs": 15798,
      "endMs": 15838,
      "speakerId": -1,
      "text": "Ты",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": [
        "Не найден говорящий слова"
      ]
    },
    {
      "startMs": 16078,
      "endMs": 18198,
      "speakerId": 0,
      "text": "слышала, что произошло на встрече с партнёрами?",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    },
    {
      "startMs": 19062,
      "endMs": 19782,
      "speakerId": 0,
      "text": "Этот новый",
