  "segments": [
    {
      "startMs": 640,
      "endMs": 5400,
      "speakerId": 0,
      "text": "Это ужасные новости. Такие люди оставляют неизгладимый след в наших жизнях.",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    },
    {
      "startMs": 6526,
      "endMs": 9486,
      "speakerId": 1,
      "text": "Ногинск, улица Советская, дом 9.",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    },
    {
      "startMs": 10526,
      "endMs": 10566,
      "speakerId": -1,
      "text": "Да",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
