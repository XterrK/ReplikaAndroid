  "segments": [
    {
      "startMs": 1310,
      "endMs": 3110,
      "speakerId": 0,
      "text": "Дима, я очень сожалею.",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    },
    {
      "startMs": 4030,
      "endMs": 4790,
      "speakerId": 0,
      "text": "Что случилось?",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    },
    {
      "startMs": 6214,
      "endMs": 11894,
      "speakerId": 1,
      "text": "76, 77, 78, 79.",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    },
    {
      "startMs": 13294,
      "endMs": 13774,
      "speakerId": 1,
      "text": "Восемьдесят.",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    },
    {
      "startMs": 14974,
      "endMs": 26294,
      "speakerId": 2,
      "text": "Облигации — это долговые ценные бумаги. Инвестор как бы даёт в долг компании или государству, а те обязуются вернуть сумму с процентами. Бывают корпоративные и государственные облигации.",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    },
    {
      "startMs": 27334,
      "endMs": 28894,
      "speakerId": 3,
      "text": "Это действительно печально, Маша.",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    },
    {
      "startMs": 29878,
      "endMs": 32358,
      "speakerId": 3,
      "text": "Такие места всегда хранят частичку души.",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    },
    {
      "startMs": 33030,
      "endMs": 33070,
      "speakerId": -1,
      "text": "И",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": [
        "Не найден говорящий слова"
      ]
    },
    {
      "startMs": 33310,
      "endMs": 34230,
      "speakerId": 3,
      "text": "много воспоминаний.",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    },
    {
      "startMs": 35262,
      "endMs": 35782,
      "speakerId": 3,
      "text": "Мне жаль.",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    },
    {
      "startMs": 36566,
      "endMs": 39886,
      "speakerId": 4,
      "text": "Оба важны. Вкус создаёт впечатление, а подача атмосферу.",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    },
    {
      "startMs": 43494,
      "endMs": 45614,
      "speakerId": 5,
      "text": "Ты можешь мне всё рассказать?",
      "source": "GigaAM v3 E2E RNNT INT8 / sherpa-onnx 2.0.1",
      "warnings": []
    }
