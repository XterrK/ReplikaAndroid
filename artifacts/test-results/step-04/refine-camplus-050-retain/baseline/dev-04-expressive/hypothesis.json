{
  "transcript": [
    {
      "speaker_id": "speaker_1",
      "start_ms": 640,
      "end_ms": 5400,
      "text": "Это ужасные новости. Такие люди оставляют неизгладимый след в наших жизнях."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 6526,
      "end_ms": 9486,
      "text": "Ногинск, улица Советская, дом 9."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 10526,
      "end_ms": 10566,
      "text": "Да"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 10846,
      "end_ms": 11646,
      "text": "уж, бесит это."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 12166,
      "end_ms": 14206,
      "text": "А у меня тоже соседи шумят по ночам."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 14726,
      "end_ms": 14966,
      "text": "Маша"
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 15798,
      "end_ms": 15838,
      "text": "Ты"
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 16078,
      "end_ms": 18198,
      "text": "слышала, что произошло на встрече с партнёрами?"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 19062,
      "end_ms": 22062,
      "text": "Этот новый менеджер сделал такой жуткий выход."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 22742,
      "end_ms": 24102,
      "text": "Что я просто остался"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 24182,
      "end_ms": 24702,
      "text": "в шоке."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 26134,
      "end_ms": 29254,
      "text": "Давай продолжать исследовать вкусовые грани французской кухни."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 30542,
      "end_ms": 30582,
      "text": "Да."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 31398,
      "end_ms": 32598,
      "text": "Жаль, что она уже не с"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 32678,
      "end_ms": 32878,
      "text": "нами."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 33438,
      "end_ms": 34838,
      "text": "Но воспоминания остались."
    }
  ]
}
