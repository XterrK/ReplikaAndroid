      "end_ms": 558,
      "text": "В"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 758,
      "end_ms": 1678,
      "text": "каком смысле?"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 3270,
      "end_ms": 3630,
      "text": "Маша."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 4486,
      "end_ms": 7166,
      "text": "Знаешь, я всегда ценил нашу способность"
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 7406,
      "end_ms": 8406,
      "text": "быть откровенными"
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 9086,
      "end_ms": 9126,
      "text": "друг"
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 9406,
      "end_ms": 9846,
      "text": "с другом,"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 10326,
      "end_ms": 12086,
      "text": "даже когда мы не соглашались."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 13606,
      "end_ms": 14886,
      "text": "Уделяю время своим"
    },
    {
      "speaker_id": "speaker_5",
      "start_ms": 14966,
      "end_ms": 15286,
      "text": "хобби"
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 15566,
      "end_ms": 16206,
      "text": "и отдыху."
    },
    {
      "speaker_id": "speaker_5",
      "start_ms": 16646,
      "end_ms": 19846,
      "text": "Это было бы неплохо. Попробуем"
    },
    {
      "speaker_id": "speaker_6",
      "start_ms": 19966,
      "end_ms": 22846,
      "text": "заново. Приятного чаепития."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 23726,
      "end_ms": 26486,
      "text": "Если что-то понадобится, звони мне."
    },
    {
      "speaker_id": "speaker_7",
      "start_ms": 27566,
      "end_ms": 31646,
      "text": "Иваново, улица Ленина, дом 45."
    }
