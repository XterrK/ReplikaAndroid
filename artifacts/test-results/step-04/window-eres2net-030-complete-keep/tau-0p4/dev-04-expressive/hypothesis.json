{
  "transcript": [
    {
      "speaker_id": "speaker_1",
      "start_ms": 640,
      "end_ms": 1840,
      "text": "Это ужасные новости."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 2320,
      "end_ms": 5400,
      "text": "Такие люди оставляют неизгладимый след в наших жизнях."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 6526,
      "end_ms": 9486,
      "text": "Ногинск, улица Советская, дом 9."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 10526,
      "end_ms": 10566,
      "text": "Да"
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 10846,
      "end_ms": 14206,
      "text": "уж, бесит это. А у меня тоже соседи шумят по ночам."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 14726,
      "end_ms": 14966,
      "text": "Маша"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 15798,
      "end_ms": 15838,
      "text": "Ты"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 16078,
      "end_ms": 18198,
      "text": "слышала, что произошло на встрече с партнёрами?"
    },
    {
      "speaker_id": "speaker_5",
      "start_ms": 19062,
      "end_ms": 19782,
      "text": "Этот новый"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 20182,
      "end_ms": 22062,
      "text": "менеджер сделал такой жуткий выход."
    },
    {
      "speaker_id": "speaker_6",
      "start_ms": 22742,
      "end_ms": 24702,
      "text": "Что я просто остался в шоке."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 26134,
      "end_ms": 29254,
      "text": "Давай продолжать исследовать вкусовые грани французской кухни."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 30542,
      "end_ms": 30582,
      "text": "Да."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 31398,
      "end_ms": 34838,
      "text": "Жаль, что она уже не с нами. Но воспоминания остались."
    }
  ]
}
