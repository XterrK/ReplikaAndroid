{
  "transcript": [
    {
      "speaker_id": "speaker_1",
      "start_ms": 482,
      "end_ms": 2086,
      "text": "Это ужасные новости."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 2210,
      "end_ms": 5510,
      "text": "Такие люди оставляют неизгладимый след в наших жизнях."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 6306,
      "end_ms": 9862,
      "text": "Ногинск, улица Советская, дом 9."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 10466,
      "end_ms": 11878,
      "text": "Да уж, бесит это."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 12098,
      "end_ms": 14246,
      "text": "А у меня тоже соседи шумят по ночам."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 14594,
      "end_ms": 15174,
      "text": "Маша"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 15778,
      "end_ms": 18342,
      "text": "Ты слышала, что произошло на встрече с партнёрами?"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 18882,
      "end_ms": 19398,
      "text": "Этот"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 19682,
      "end_ms": 19977,
      "text": "Но"
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 19977,
      "end_ms": 22342,
      "text": "Новый менеджер сделал такой жуткий выход."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 23042,
      "end_ms": 24870,
      "text": "Я просто остался в шоке."
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 26274,
      "end_ms": 29446,
      "text": "Как продолжать исследовать вкусовые грани французской кухни?"
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 30402,
      "end_ms": 30950,
      "text": "Да."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 31458,
      "end_ms": 32650,
      "text": "Жаль, что она уже не"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 32650,
      "end_ms": 32937,
      "text": "нами"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 33378,
      "end_ms": 35014,
      "text": "Но воспоминания остались."
    }
  ]
}
