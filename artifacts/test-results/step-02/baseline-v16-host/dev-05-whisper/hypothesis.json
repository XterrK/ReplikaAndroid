{
  "transcript": [
    {
      "speaker_id": "speaker_1",
      "start_ms": 578,
      "end_ms": 1958,
      "text": "В каком смысле?"
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 3170,
      "end_ms": 3878,
      "text": "Маша."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 4386,
      "end_ms": 8582,
      "text": "Знаешь, я всегда ценил нашу способность быть откровенными."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 9058,
      "end_ms": 9926,
      "text": "Друг с другом."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 10242,
      "end_ms": 12198,
      "text": "Даже когда мы не соглашались."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 13666,
      "end_ms": 13970,
      "text": "У тебя"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 13970,
      "end_ms": 15033,
      "text": "Даю время своим."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 15033,
      "end_ms": 15252,
      "text": "Вот"
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 15252,
      "end_ms": 15556,
      "text": "Пи."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 15556,
      "end_ms": 15978,
      "text": "И вот"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 15978,
      "end_ms": 16585,
      "text": "То."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 16585,
      "end_ms": 18087,
      "text": "Это было бы неплохо."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 19266,
      "end_ms": 20365,
      "text": "Попробуем заново."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 21410,
      "end_ms": 22897,
      "text": "Приятного чаепития."
    },
    {
      "speaker_id": "speaker_3",
      "start_ms": 22897,
      "end_ms": 23673,
      "text": "Я"
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 23673,
      "end_ms": 25208,
      "text": "Если что-то понадобится"
    },
    {
      "speaker_id": "speaker_4",
      "start_ms": 25867,
      "end_ms": 26693,
      "text": "Звони мне."
    },
    {
      "speaker_id": "speaker_5",
      "start_ms": 27458,
      "end_ms": 28448,
      "text": "Иваново."
    },
    {
      "speaker_id": "speaker_5",
      "start_ms": 29005,
      "end_ms": 31739,
      "text": "Улица Ленина, дом 45."
    },
    {
      "speaker_id": "speaker_5",
      "start_ms": 31739,
      "end_ms": 31958,
      "text": "Пять"
    }
  ]
