{
  "transcript": [
    {
      "speaker_id": "speaker_1",
      "start_ms": 250,
      "end_ms": 2475,
      "text": "But I stayed that spring and built me a boat."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 2948,
      "end_ms": 5568,
      "text": "The greeting of the Apostle is refreshing."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 6346,
      "end_ms": 8456,
      "text": "I painted the eyes red for anger."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 8919,
      "end_ms": 11629,
      "text": "Not all the Galatians had become perverted."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 12212,
      "end_ms": 15097,
      "text": "May you drink heart's ease from it for many years."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 15637,
      "end_ms": 17612,
      "text": "Experience proves this."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 18078,
      "end_ms": 20978,
      "text": "Now she put her hand on his arm and smiled and said"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 21644,
      "end_ms": 24664,
      "text": "The world brands this a pernicious doctrine."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 25435,
      "end_ms": 28680,
      "text": "Thirty men, one after another, raised their horns and said"
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 29392,
      "end_ms": 31762,
      "text": "It spoils one's best work."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 32636,
      "end_ms": 36286,
      "text": "It is manifest that man is now subject to much variability."
    },
    {
      "speaker_id": "speaker_2",
      "start_ms": 36613,
      "end_ms": 40343,
      "text": "In every way they sought to undermine the authority of Saint Paul."
    },
    {
      "speaker_id": "speaker_1",
      "start_ms": 41006,
      "end_ms": 44571,
      "text": "Effects of the increased use and disuse of parts"
    }
  ]
}
